# /etc/algo-traders-sync.env (chmod 600)
# Service-role key — DO NOT commit and DO NOT ship to the browser.
SUPABASE_URL=https://wbtyqhccgdjnmsstcovm.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY_FROM_DASHBOARD

# Path inside the VPS to the bind-mounted freqtrade db.
# Per live/ops/docker-compose.yml, the host path is:
FREQTRADE_DB_PATH=/root/algo-traders/live/tracks/hl_paper/freqtrade/tradesv3.sqlite

# Used to compute total_profit_pct. Set to the bot's actual starting stake.
STARTING_BALANCE=1000

# Optional — short git sha or version tag, surfaced on the dashboard footer.
SYNC_VERSION=dev
