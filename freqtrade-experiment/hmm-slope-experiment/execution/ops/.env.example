# Track B ops secrets. Copy to .env and fill in. .env is gitignored.

# Telegram bot for alerts + remote /stop (gate 002 §Hosting).
# Create via @BotFather; chat_id via @userinfobot or by messaging the bot then
# hitting https://api.telegram.org/bot<TOKEN>/getUpdates.
FT_TELEGRAM_ENABLED=true
FT_TELEGRAM_TOKEN=
FT_TELEGRAM_CHAT_ID=

# Freqtrade REST API auth — used by the healthcheck container to poll /ping.
# Pick a long random password; the API is bound to 127.0.0.1 only.
FT_API_USERNAME=freqtrade
FT_API_PASSWORD=

# healthchecks.io ping URL for the 5-minute liveness signal.
# Create a "Cron" style check, period 5m, grace 5m. Paste the ping URL here.
HEALTHCHECK_URL=
